{
  "name": "vsuee-skill",
  "version": "1.0.0",
  "description": "High-speed CLI toolkit and AI agent skill for the Visayas State University E-Learning Environment (VSUEE Moodle).",
  "keywords": [
    "vsuee",
    "vsuee-skill",
    "vsu",
    "moodle",
    "elearning",
    "agent-skill",
    "ai-agent",
    "calendar-export",
    "sync",
    "downloader",
    "automation",
    "playwright"
  ],
  "homepage": "https://github.com/M1Vj/vsuee-skill#readme",
  "bugs": {
    "url": "https://github.com/M1Vj/vsuee-skill/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CedricDeVon/vsuee-skill"
  },
  "license": "MIT",
  "author": "Vj Mabansag",
  "type": "module",
  "main": "./lib/moodle-client.mjs",
  "bin": {
    "vsuee": "./bin/vsuee.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "plugin.json",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test test/moodle-client.test.mjs test/moodle-client-downloads.test.mjs test/session-auth.test.mjs test/sync-manager.test.mjs test/browser-runner.test.mjs",
    "test:all": "node --test test/*.test.mjs",
    "test:live": "VSUEE_LIVE_TEST=1 node --test test/integration.test.mjs",
    "test:release:package-content": "node test/release-package-content.test.mjs .tmp/build/release/package",
    "test:release:local-installation": "node test/local-installation.test.mjs .tmp/test/environment/release/installation .tmp/build/release/dist/vsuee-skill.tgz",
    "tmp:cleanup": "node scripts/remove-filesystem-path.mjs .tmp",
    "tmp:setup": "node scripts/setup-filesystem-tree.mjs .tmp/build/release/package .tmp/build/release/dist .tmp/test/environment/release/installation",
    "build:release:package": "node scripts/copy-filesystem-path.mjs .tmp/build/release/package package.json LICENSE plugin.json README.md bin lib skills",
    "build:release:dist": "node scripts/npm-pack-tarball.mjs .tmp/build/release/package .tmp/build/release/dist",
    "rename:release:dist": "node scripts/rename-filesystem-path.mjs .tmp/build/release/dist \"*.tgz\" vsuee-skill.tgz",
    "deploy:staged:npm:release": "npm stage publish .tmp/build/release/package",
    "workflow:stage-release": "node scripts/run-scripts.mjs tmp:cleanup tmp:setup build:release:package build:release:dist rename:release:dist test:release:package-content test:release:local-installation"
  },
  "peerDependencies": {
    "playwright": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
