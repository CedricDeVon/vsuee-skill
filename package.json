{
  "name": "vsuee-skill",
  "version": "0.0.0",
  "description": "High-speed CLI toolkit and AI agent skill for the Visayas State University E-Learning Environment (VSUEE Moodle).",
  "keywords": [
    "vsuee",
    "vsuee-skill",
    "vsu",
    "moodle",
    "elearning",
    "agent-skill",
    "ai-agent",
    "calendar-export",
    "sync",
    "downloader",
    "automation",
    "playwright"
  ],
  "homepage": "https://github.com/M1Vj/vsuee-skill#readme",
  "bugs": {
    "url": "https://github.com/M1Vj/vsuee-skill/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M1Vj/vsuee-skill.git"
  },
  "license": "MIT",
  "author": "Vj Mabansag",
  "type": "module",
  "main": "./lib/moodle-client.mjs",
  "bin": {
    "vsuee": "./bin/vsuee.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "plugin.json",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test test/moodle-client.test.mjs test/moodle-client-downloads.test.mjs test/session-auth.test.mjs test/sync-manager.test.mjs test/browser-runner.test.mjs",
    "test:all": "node --test test/*.test.mjs",
    "test:live": "VSUEE_LIVE_TEST=1 node --test test/integration.test.mjs",
    "test:release-package-content": "node test/release-package-content.test.mjs .output/build/release/package",
    "output:cleanup": "node scripts/remove-filesystem-path.mjs .output",
    "output:setup": "node scripts/setup-filesystem-tree.mjs .output/build/release/package .output/build/release/dist",
    "build:release:package": "node scripts/copy-filesystem-path.mjs .output/build/release/package package.json LICENSE plugin.json README.md bin lib skills",
    "build:release:dist": "node scripts/npm-pack-tarball.mjs .output/build/release/package .output/build/release/dist",
    "rename:release:dist": "node scripts/rename-filesystem-path.mjs .output/build/release/dist \"*.tgz\" vsuee-skill.tgz",
    "deploy:local:release": "npm install .output/build/release/dist/vsuee-skill.tgz",
    "deploy:global:release": "npm install -g .output/build/release/dist/vsuee-skill.tgz",
    "deploy:npm:release": "npm publish .output/build/release/package",
    "clean:local:release": "npm uninstall vsuee-skill",
    "clean:global:release": "npm uninstall -g vsuee-skill",
    "clean:all:release": "node scripts/run-scripts.mjs clean:local:release clean:global:release",
    "workflow:stage-release": "node scripts/run-scripts.mjs output:cleanup output:setup build:release:package build:release:dist rename:release:dist test:release-package-content",
    "workflow:local-deploy": "node scripts/run-scripts.mjs workflow:stage-release clean:local:release deploy:local:release",
    "workflow:global-deploy": "node scripts/run-scripts.mjs workflow:stage-release clean:global:release deploy:global:release"
  },
  "peerDependencies": {
    "playwright": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
